#!/usr/bin/env bash
#
# The dictation vocabulary: one parser, and the two commands that maintain it.
#
# READ (the hot path, unchanged and load-bearing). Prints the vocabulary as one
# comma-joined line, so that both consumers -- whisper.initial_prompt (set by
# the installer for the host) and the "Prefer these spellings" rule in
# voxtype-cleanup's system prompt -- read the same file instead of each carrying
# its own hand-maintained copy.
#
#   voxtype-vocab misheard     terms whisper renders as different words
#   voxtype-vocab misspelled   terms it hears right and writes wrong
#   voxtype-vocab all          both, misheard first (the default)
#
# WRITE (the reason this script grew past a parser). Adding a term used to mean
# knowing two things that are nowhere near each other: that the file to edit is
# the REPO copy rather than the installed one, and which installer to re-run
# afterwards to push the [misheard] half into whisper.initial_prompt. Editing
# the installed copy looks like it works -- the cleanup filter picks it up on
# the next dictation -- and is then silently reverted by the next install.
#
#   voxtype-vocab add btrfs           add to [misspelled] and apply
#   voxtype-vocab add -m Hyprland     add to [misheard] instead
#   voxtype-vocab add -n foo bar      several terms, apply skipped
#   voxtype-vocab edit                $EDITOR on the source, apply if changed
#   voxtype-vocab apply               re-run this host's installer, scoped
#   voxtype-vocab list                what is in each section, and where
#   voxtype-vocab path                the resolved source + apply command
#
# The write path needs two facts the read path does not: where the source file
# lives, and how to apply it. Both are host-specific -- an Omarchy box applies
# with `apply.sh --only voxtype`, a standalone Linux or macOS install re-runs
# its own installer -- so neither is hardcoded here. Each installer records them
# in ~/.config/voxtype/vocab-source.conf as it installs, which is also what
# makes this script generic enough to ship unchanged to the release repo, where
# the apply command is a different installer entirely.
#
# OS-agnostic on purpose, and portable to match: /usr/bin/env bash so it runs
# under macOS's bash 3.2 (so no ${x,,}, no associative arrays, no mapfile), and
# POSIX awk programs so BSD awk and gawk agree.
#
# VOXTYPE_VOCAB_FILE overrides the file the READ path parses, which is how each
# installer reads the repo copy rather than depending on its own install having
# already happened. VOXTYPE_VOCAB_SOURCE and VOXTYPE_VOCAB_APPLY override the
# two facts above for the write path.
#
# A missing or empty file makes the READ path print nothing and exit 0. That is
# deliberate: voxtype-cleanup calls this on the dictation path, where THE ONE
# RULE is never to lose the user's words, so a vocabulary problem has to degrade
# into a slightly worse prompt and never into a failed filter. The installers,
# which can afford to complain, check for the empty result themselves. The WRITE
# path takes the opposite stance and fails loudly -- a silent no-op there is a
# term you believe you added and did not.
set -euo pipefail

SELF="${BASH_SOURCE[0]}"
SELF_DIR="$(cd -P "$(dirname "$SELF")" && pwd)"
CONF_DIR="$HOME/.config/voxtype"
PTR_FILE="$CONF_DIR/vocab-source.conf"

die()  { printf 'voxtype-vocab: %s\n' "$*" >&2; exit 1; }
say()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m warn:\033[0m %s\n' "$*" >&2; }

usage() { sed -n '/^# The dictation vocabulary/,/^set -euo/p' "$SELF" | sed '$d;s/^# \{0,1\}//;s/^#$//'; }

# ------------------------------------------------------------ read path -----

# The file the section commands parse. Installed copy first: that is the one
# the running system actually uses, so `voxtype-vocab all` reports reality even
# when it disagrees with the checkout.
read_file() {
  if [ -n "${VOXTYPE_VOCAB_FILE:-}" ]; then
    printf '%s' "$VOXTYPE_VOCAB_FILE"
  elif [ -f "$CONF_DIR/vocabulary.conf" ]; then
    printf '%s' "$CONF_DIR/vocabulary.conf"
  else
    # Nothing installed yet? Use the copy next to this script -- in the checkout
    # that is scripts/voxtype/vocabulary.conf, the very file both installers copy
    # from -- so running voxtype-cleanup straight out of the tree (bench-cleanup.sh
    # does) measures the prompt the installed filter actually sends.
    printf '%s' "$SELF_DIR/vocabulary.conf"
  fi
}

emit() { # emit <section> <file>
  [ -f "$2" ] || exit 0
  awk -v want="$1" '
    {
      line = $0
      sub(/^[[:space:]]+/, "", line)
      sub(/[[:space:]]+$/, "", line)
    }
    line == "" || line ~ /^#/ { next }
    line ~ /^\[[^][]+\]$/     { sec = substr(line, 2, length(line) - 2); next }
    {
      if (want != "all" && want != sec) next
      if (seen[line]++) next
      out = (out == "" ? line : out ", " line)
    }
    END { if (out != "") print out }
  ' "$2"
}

# ----------------------------------------------------------- write path -----

# One KEY=value per line, read rather than sourced: this file is written by an
# installer and read by a script that runs on the dictation path, so it stays
# data and never becomes code.
ptr_get() { # ptr_get <KEY>  -> value on stdout, non-zero if absent
  [ -f "$PTR_FILE" ] || return 1
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in
      "$1="*) printf '%s' "${line#*=}"; return 0 ;;
    esac
  done < "$PTR_FILE"
  return 1
}

# The file a term is TYPED into, which is not the file the read path parses.
# The installed copy is a build artifact; editing it is reverted by the next
# install, so the write path refuses to touch it.
source_file() {
  local s=""
  if [ -n "${VOXTYPE_VOCAB_SOURCE:-}" ]; then
    s="$VOXTYPE_VOCAB_SOURCE"
  elif s="$(ptr_get VOXTYPE_VOCAB_SOURCE)"; then
    :
  elif [ -f "$SELF_DIR/vocabulary.conf" ]; then
    # Run straight out of a checkout, before any install has happened.
    s="$SELF_DIR/vocabulary.conf"
  else
    die "cannot find the vocabulary SOURCE (the repo copy, not $CONF_DIR/vocabulary.conf).
  Re-run this host's installer to record it, or set VOXTYPE_VOCAB_SOURCE=<path>.
  Expected a pointer at: $PTR_FILE"
  fi
  [ -f "$s" ] || die "recorded vocabulary source is missing: $s
  The checkout moved or was removed. Re-run the installer from its new location."
  printf '%s' "$s"
}

# Resolved into APPLY_CMD (a path, quoted when run) and APPLY_ARGS (fixed flags,
# deliberately word-split -- they are the installer's own, never user input).
APPLY_CMD="" APPLY_ARGS=""
resolve_apply() {
  if [ -n "${VOXTYPE_VOCAB_APPLY:-}" ]; then
    APPLY_CMD="$VOXTYPE_VOCAB_APPLY"
    APPLY_ARGS="${VOXTYPE_VOCAB_APPLY_ARGS:-}"
  else
    APPLY_CMD="$(ptr_get VOXTYPE_VOCAB_APPLY)" || return 1
    APPLY_ARGS="$(ptr_get VOXTYPE_VOCAB_APPLY_ARGS || true)"
  fi
  [ -n "$APPLY_CMD" ]
}

trim() { printf '%s' "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'; }

# Which section already holds this term, case-insensitively? Case-insensitive
# because "pytorch" and "PyTorch" as two entries is never what anyone meant, and
# the second one silently does nothing.
find_term() { # find_term <term> <file>  -> section name on stdout, empty if absent
  local lower
  lower="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  awk -v want="$lower" '
    {
      line = $0
      sub(/^[[:space:]]+/, "", line)
      sub(/[[:space:]]+$/, "", line)
    }
    line == "" || line ~ /^#/ { next }
    line ~ /^\[[^][]+\]$/     { sec = substr(line, 2, length(line) - 2); next }
    { if (tolower(line) == want) { print sec; exit } }
  ' "$2"
}

# Append at the end of <section>, creating the section if the file has no such
# header. Written to a temp file and moved over, so an awk that fails partway
# cannot leave a half-written vocabulary behind.
insert_term() { # insert_term <section> <term> <file>
  local tmp
  tmp="$(mktemp "${TMPDIR:-/tmp}/voxtype-vocab.XXXXXX")"
  awk -v sec="$1" -v term="$2" '
    {
      t = $0
      sub(/^[[:space:]]+/, "", t)
      sub(/[[:space:]]+$/, "", t)
      if (t ~ /^\[[^][]+\]$/) {
        if (cur == sec && !done) { print term; done = 1 }
        cur = substr(t, 2, length(t) - 2)
      }
      print
    }
    END {
      if (!done && cur == sec) { print term; done = 1 }
      if (!done) { print "[" sec "]"; print term }
    }
  ' "$3" > "$tmp" || { rm -f "$tmp"; die "failed to rewrite $3"; }
  # Preserve the original mode; mktemp makes 0600 and this file is world-readable
  # config that the installers copy with `install -m 644`.
  cat "$tmp" > "$3" && rm -f "$tmp"
}

# whisper.cpp truncates a long initial_prompt silently, and on near-silent audio
# whisper echoes it back as if it had been spoken -- so a long [misheard] is a
# sentence of garbage typed into whatever is focused the day VAD misses a stray
# press. The installers carry this same guard; repeating it here means you hear
# about it when you add the term, not after the apply.
check_misheard_budget() { # check_misheard_budget <file>
  local list n
  list="$(emit misheard "$1" || true)"
  [ -n "$list" ] || return 0
  n="$(awk -F", " '{print NF}' <<<"$list")"
  [ "$n" -le 40 ] ||
    warn "[misheard] is $n terms (over 40); move the ones whisper only mis-SPELLS to [misspelled]"
}

do_apply() {
  local src; src="$(source_file)"
  check_misheard_budget "$src"
  resolve_apply || die "no apply command recorded for this host.
  Re-run this host's installer once to record it, or set:
    VOXTYPE_VOCAB_APPLY=<installer path>  VOXTYPE_VOCAB_APPLY_ARGS=<flags>
  Expected a pointer at: $PTR_FILE"
  [ -x "$APPLY_CMD" ] || die "recorded apply command is not executable: $APPLY_CMD"
  say "applying: $APPLY_CMD $APPLY_ARGS"
  # shellcheck disable=SC2086  # APPLY_ARGS is the installer's own flag list.
  "$APPLY_CMD" $APPLY_ARGS
}

cmd_add() {
  local section=misspelled apply=1 nterms=0 a
  # Split from the `local` above and counted by hand rather than with
  # ${#terms[@]}: macOS ships bash 3.2, where `set -u` treats an empty array's
  # expansion as an unbound variable. `voxtype-vocab add` with no term has to
  # print its usage error, not "unbound variable".
  local -a terms
  terms=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -m|--misheard)   section=misheard ;;
      -s|--misspelled) section=misspelled ;;
      -n|--no-apply)   apply=0 ;;
      --) shift; while [ $# -gt 0 ]; do terms[nterms]="$1"; nterms=$((nterms + 1)); shift; done; break ;;
      -*) die "add: unknown flag '$1' (try -m/--misheard, -n/--no-apply)" ;;
      *)  terms[nterms]="$1"; nterms=$((nterms + 1)) ;;
    esac
    shift
  done
  [ "$nterms" -gt 0 ] || die "add: needs at least one term"

  local src; src="$(source_file)"
  local added=0
  for a in "${terms[@]}"; do
    local term; term="$(trim "$a")"
    [ -n "$term" ] || die "add: empty term"
    die_if_bad_term "$term"
    local where; where="$(find_term "$term" "$src")"
    if [ -n "$where" ]; then
      warn "already in [$where]: $term"
      continue
    fi
    insert_term "$section" "$term" "$src"
    printf '    added      [%s] %s\n' "$section" "$term"
    added=$((added + 1))
  done

  [ "$added" -gt 0 ] || { say "nothing added; not applying"; return 0; }
  printf '    edited     %s\n' "$src"
  if [ "$section" = misheard ]; then
    warn "[misheard] costs an initial_prompt slot on every dictation; keep it for words"
    warn "  whisper turns into DIFFERENT words, not ones it merely mis-spells."
    # Also checked in do_apply, but --no-apply skips that and this is the moment
    # the budget is worth hearing about.
    check_misheard_budget "$src"
  fi
  if [ "$apply" -eq 1 ]; then do_apply; fi
  return 0
}

# The file format is comma-joined for both consumers and section headers are
# structural, so these three are corruption rather than an odd term.
die_if_bad_term() { # die_if_bad_term <term>
  case "$1" in
    *,*)     die "add: a term cannot contain a comma (the list is comma-joined): $1" ;;
    '#'*)    die "add: a term cannot start with '#' (that is a comment line): $1" ;;
    '['*']') die "add: a term cannot look like a [section] header: $1" ;;
  esac
}

cmd_list() {
  local src apply_desc
  src="$(source_file)"
  printf 'source : %s\n' "$src"
  if resolve_apply; then apply_desc="$APPLY_CMD $APPLY_ARGS"; else apply_desc="(not recorded -- run the installer once)"; fi
  printf 'apply  : %s\n' "$apply_desc"
  printf 'in use : %s\n\n' "$(read_file)"
  local sec
  for sec in misheard misspelled; do
    local list n
    list="$(emit "$sec" "$src" || true)"
    if [ -z "$list" ]; then n=0; else n="$(awk -F", " '{print NF}' <<<"$list")"; fi
    printf '[%s] (%s)\n' "$sec" "$n"
    if [ -n "$list" ]; then printf '%s\n' "$list" | tr ',' '\n' | sed 's/^ */  /'; fi
    printf '\n'
  done
  check_misheard_budget "$src"
}

cmd_edit() {
  local src; src="$(source_file)"
  local ed="${VISUAL:-${EDITOR:-vi}}"
  local before
  before="$(mktemp "${TMPDIR:-/tmp}/voxtype-vocab-before.XXXXXX")"
  cp "$src" "$before"
  # Word-split on purpose: EDITOR is conventionally a command line ("code -w").
  # shellcheck disable=SC2086
  $ed "$src" || { rm -f "$before"; die "editor exited non-zero; not applying"; }
  if cmp -s "$before" "$src"; then
    rm -f "$before"
    say "unchanged; nothing to apply"
    return 0
  fi
  rm -f "$before"
  printf '    edited     %s\n' "$src"
  do_apply
}

cmd_path() {
  printf 'source     %s\n' "$(source_file)"
  printf 'in use     %s\n' "$(read_file)"
  printf 'pointer    %s%s\n' "$PTR_FILE" "$([ -f "$PTR_FILE" ] || printf ' (absent)')"
  if resolve_apply; then
    printf 'apply      %s %s\n' "$APPLY_CMD" "$APPLY_ARGS"
  else
    printf 'apply      (not recorded -- run this host'"'"'s installer once)\n'
  fi
}

# ------------------------------------------------------------- dispatch -----

SECTION="${1:-all}"
case "$SECTION" in
  misheard|misspelled|all) ;;
  add)          shift; cmd_add "$@";  exit ;;
  edit)         shift; cmd_edit "$@"; exit ;;
  apply)        shift; do_apply;      exit ;;
  list)         shift; cmd_list;      exit ;;
  path|where)   shift; cmd_path;      exit ;;
  -h|--help)    usage; exit 0 ;;
  *) echo "voxtype-vocab: unknown section '$SECTION' (try --help)" >&2; exit 2 ;;
esac

emit "$SECTION" "$(read_file)"
