<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
  IgnorableNamespaces="desktop uap uap3 rescap virtualization">
  <Identity Name="@@IDENTITY_NAME@@" Publisher="@@PUBLISHER@@" Version="@@VERSION@@"
            ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>VoxType</DisplayName>
    <PublisherDisplayName>@@PUBLISHER_DISPLAY_NAME@@</PublisherDisplayName>
    <Description>Local push-to-talk dictation</Description>
    <Logo>Assets\StoreLogo.png</Logo>
    <virtualization:FileSystemWriteVirtualization>
      <virtualization:ExcludedDirectories>
        <virtualization:ExcludedDirectory>$(KnownFolder:LocalAppData)\VoxType</virtualization:ExcludedDirectory>
        <virtualization:ExcludedDirectory>$(KnownFolder:RoamingAppData)\VoxType</virtualization:ExcludedDirectory>
      </virtualization:ExcludedDirectories>
    </virtualization:FileSystemWriteVirtualization>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22621.0"
                        MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <!-- Windows starts only the executables an Application below names. Any other exe in
       the package is refused with "Access is denied" (win32 error 5), even when a process
       of this package starts it, so every exe the package runs has an entry here, hidden
       from Start. build-msix.ps1 refuses to pack an exe that has none. -->
  <Applications>
    <Application Id="VoxType" Executable="voxtype.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="VoxType" Description="Local push-to-talk dictation"
        BackgroundColor="transparent" Square44x44Logo="Assets\Square44x44Logo.png"
        Square150x150Logo="Assets\Square150x150Logo.png" AppListEntry="none" />
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="voxtype.exe"
                        EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="voxtype.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
    <Application Id="VoxTypeConfigure" Executable="voxtype-configure.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Configure VoxType"
        Description="Choose a dictation key, model, audio device and output"
        BackgroundColor="transparent" Square44x44Logo="Assets\Square44x44Logo.png"
        Square150x150Logo="Assets\Square150x150Logo.png" />
      <Extensions>
        <uap:Extension Category="windows.protocol" Executable="voxtype-configure.exe"
                       EntryPoint="Windows.FullTrustApplication">
          <uap:Protocol Name="voxtype-configure" />
        </uap:Extension>
        <desktop:Extension Category="windows.startupTask" Executable="voxtype-startup.exe"
                           EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="VoxTypeStartup" Enabled="true"
                               DisplayName="VoxType local dictation" />
        </desktop:Extension>
      </Extensions>
    </Application>
    <Application Id="VoxTypeLocal" Executable="voxtype-local.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="VoxType Local Tools"
        Description="Configure VoxType local cleanup"
        BackgroundColor="transparent" Square44x44Logo="Assets\Square44x44Logo.png"
        Square150x150Logo="Assets\Square150x150Logo.png" AppListEntry="none" />
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="voxtype-local.exe"
                        EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="voxtype-local.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
    <Application Id="VoxTypeStartup" Executable="voxtype-startup.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="VoxType startup"
        Description="Starts VoxType when you sign in"
        BackgroundColor="transparent" Square44x44Logo="Assets\Square44x44Logo.png"
        Square150x150Logo="Assets\Square150x150Logo.png" AppListEntry="none" />
    </Application>
    <Application Id="VoxTypeCleanupServer" Executable="voxtype-cleanup-server.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="VoxType cleanup server"
        Description="Starts the local cleanup model"
        BackgroundColor="transparent" Square44x44Logo="Assets\Square44x44Logo.png"
        Square150x150Logo="Assets\Square150x150Logo.png" AppListEntry="none" />
    </Application>
    <Application Id="VoxTypeLlamaServer" Executable="windows\bin\llama-server.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="VoxType local cleanup model"
        Description="llama.cpp serving the local cleanup model"
        BackgroundColor="transparent" Square44x44Logo="Assets\Square44x44Logo.png"
        Square150x150Logo="Assets\Square150x150Logo.png" AppListEntry="none" />
    </Application>
    <Application Id="VoxTypeDeviceCheck" Executable="llama-server.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="VoxType GPU check"
        Description="Lists the GPUs the local cleanup model can use"
        BackgroundColor="transparent" Square44x44Logo="Assets\Square44x44Logo.png"
        Square150x150Logo="Assets\Square150x150Logo.png" AppListEntry="none" />
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
